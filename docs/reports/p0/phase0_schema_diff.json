  "migration_requirements": [
    {
      "id": "MIG-01",
      "requirement": "新增独立 v2 模块与 schema 标识，不修改 v1 行为；v1 33 条回归测试必须继续通过",
      "spec_ref": "§25, §27.1",
      "verification": "全新 schema id + schema_version；v1 文件不改语义"
    },
    {
      "id": "MIG-02",
      "requirement": "v1→v2 转换必须显式传参：system_boot_id、px4_boot_id、localization_epoch、control_epoch、clock_id(clock domain registry)、sync_generation、observation_id、input_capture_interval_ns、earliest_input_safe_deadline_ns、axis_validity、sequence_id",
      "spec_ref": "§16.3, §16.6, §10.4",
      "verification": "缺任一项即拒绝转换，禁止用 0/当前时刻/默认字符串补齐"
    },
    {
      "id": "MIG-03",
      "requirement": "轴有效性不得从速度数值推断：v_xy_valid=false 拒绝水平速度；v_z_valid=false 拒绝整个正常速度动作，1511 默认拒绝",
      "spec_ref": "§10.4.2, §10.4.3",
      "verification": "单元测试覆盖四轴组合与 default-deny"
    },
    {
      "id": "MIG-04",
      "requirement": "TTL 语义改为 expires_at = min(issued_at + action_ttl, earliest_input_safe_deadline_ns)，Sender 不得刷新 issued_at",
      "spec_ref": "§16.6, §27.5",
      "verification": "边界测试 now>=expires；慢推理场景测试"
    },
    {
      "id": "MIG-05",
      "requirement": "序号与重发：ADMIT_NEW 严格递增；SEND_CACHED 要求 action_id/payload 摘要/源时间/上下文完全一致且仍为当前缓存动作，不递增、不续期",
      "spec_ref": "§16.6 规则 5, §27.3",
      "verification": "乱序/复用/回滚缓存拒绝测试"
    },
    {
      "id": "MIG-06",
      "requirement": "时钟域：字符串 clock_id 改为版本化 uint64 域 + sync_generation + 误差界；跨域比较需有效映射，否则拒绝并标 UNKNOWN",
      "spec_ref": "§16.1, §16.3.2",
      "verification": "不同类型/域不匹配测试；最坏年龄计算测试"
    },
    {
      "id": "MIG-07",
      "requirement": "坐标系单向链：策略 4D 归一化 → v2 载荷(BODY_HEADING_FLU 物理单位) → PX4 Adapter(LOCAL_NED, 有效 yaw) ；禁止二次旋转与在 v2 载荷重做 ENU 中间层",
      "spec_ref": "§10.4.1, §10.4.2, §26.3",
      "verification": "四航向、vz 符号、yaw-rate 符号 SITL 单测计划（未运行）"
    },
    {
      "id": "MIG-08",
      "requirement": "Epoch：origin_epoch 拆分为 localization_epoch + control_epoch；任何交接必须递增 control_epoch（含 PENDING→ACTIVE 过程）",
      "spec_ref": "§16.2, §16.4, §16.8",
      "verification": "交接期间动作到达测试；旧 owner 发包拒绝测试"
    },
    {
      "id": "MIG-09",
      "requirement": "PX4 单独重启：生成新 px4_boot_id、作废时间映射/状态缓存/在途动作与推理，递增 epoch 并退出正常控制",
      "spec_ref": "§16.3.2",
      "verification": "boot_id 变化拒绝对应动作；与 Companion 重启区分测试"
    },
    {
      "id": "MIG-10",
      "requirement": "日志最小字段按 §27.7 输出，含 reject_reason 与实际 MAVLink message ID；不得只记录成功发送",
      "spec_ref": "§27.7",
      "verification": "日志字段 schema 测试（未实现）"
    },
    {
      "id": "MIG-11",
      "requirement": "版本矩阵：Schema/Producer/Consumer/Firmware/Model/Map 版本声明，不兼容拒绝启动或显式降级",
      "spec_ref": "§27.1",
      "verification": "启动检查测试（未实现）"
    },
    {
      "id": "MIG-12",
      "requirement": "规范歧义登记：NormalVelocityAction 与 Header/Envelope 的上下文重复、schema_version 字符串 vs uint32，先登记再实现",
      "spec_ref": "§10.4 vs §16.3/§16.6",
      "verification": "SPEC_DISCREPANCIES 条目 + 决策记录"
    }
  ],
