  "required_replay_semantics": {
    "runner": "extract scripts/run_dynamic_eval.py and the src/boom_birds modules from source_commit 0546701 into a read-only tmp/dsh_contact_lifecycle_replay_src directory (git show / git archive), never checkout or rewrite the shared worktree",
    "initial_state": "env.reset(seed=0) once; per episode write case start pose/yaw and zero root velocity; obstacle starts at (0,0,50) and is posed each step from case formula",
    "policy": "RouteSupervisor + WaypointRunner (arrival 0.25 m, speed 0.2 m/s, intermediate hold 0.2 s, final hold 0.5 s, segment timeout 60 s) + V2ActionGate (TTL 150 ms, max_age 150 ms, allowed observation age 300 ms) + VelocityExecutor",
    "clock_and_queue": "obs_delay 0.15 s, action_delay 0.10 s, SimClock camera offset 20 ms / drift 200 ppm / uncertainty 5 ms, no injected fail steps (all -1)",
    "obstacle_trajectory": "linear start+velocity*t with obstacle end_time clamp enabled (--obstacle-time-clamp)",
    "episode_boundary": "EpisodeBoundary.start(seed=case.seed or 9000); env._get_dones override; no per-episode env reset; max_steps=ceil(case.timeout_s/0.05)",
    "measurement_adaptation": "inject the lifecycle-fixed contact readout as an observer only; do not alter control, obstacle, clock, queue or boundary logic; record raw sensor tensors and read health"
  },
